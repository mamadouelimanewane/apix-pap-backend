# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/apix_pap
MONGODB_TEST_URI=mongodb://localhost:27017/apix_pap_test

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production_12345
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,https://apix-pap.vercel.app

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_API_DOCS=true
ENABLE_METRICS=true
