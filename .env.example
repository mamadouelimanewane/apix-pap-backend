# ===========================
# APIX-PAP Backend Configuration
# ===========================

# Serveur
NODE_ENV=development
PORT=3000
HOST=localhost

# Base de données MongoDB
# Local
MONGODB_URI=mongodb://localhost:27017/apix_pap

# Production (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/apix_pap?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_very_secret_key_change_in_production_generate_with_crypto
JWT_EXPIRE=7d

# CORS - Origines autorisées
# Développement
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Production
# CORS_ORIGIN=https://apix-pap.vercel.app,https://api-apix-pap.vercel.app

# Logging
LOG_LEVEL=debug

# Seed Database (commandes)
# npm run seed
